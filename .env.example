# ============================================================================
# Genivra CNS Risk Engine - Environment Configuration
# 
# Copy this file to .env and fill in actual values
# .env is gitignored and not committed to source control
# ============================================================================

# ============================================================================
# API Configuration
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# API Port (for local development)
PORT=8000

# API Host (for local development)
HOST=127.0.0.1

# Enable detailed logging
LOG_LEVEL=INFO

# ============================================================================
# API Key Configuration
# ============================================================================

# Override demo API keys with production keys (comma-separated)
# Format: key1:tier2:name1,key2:tier1:name2
# Example: prod_key_001:tier_2:Client A,prod_key_002:tier_1:Client B
API_KEYS_OVERRIDE=

# Tier 1 Monthly Rate Limit (requests per month)
TIER_1_MONTHLY_LIMIT=100

# Tier 2 Monthly Rate Limit (0 = unlimited)
TIER_2_MONTHLY_LIMIT=0

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins (comma-separated, use * for all in development only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Model Configuration
# ============================================================================

# Path to trained model artifacts
MODEL_ARTIFACT_DIR=Models/artifacts

# Path to feature scaler
FEATURE_SCALER_PATH=Models/artifacts/feature_scaler.pkl

# Path to logistic regression model
LOGISTIC_MODEL_PATH=Models/artifacts/logistic_model.pkl

# ============================================================================
# Database Configuration (Future)
# ============================================================================

# For eventual migration from in-memory to database
DATABASE_URL=sqlite:///./genivra.db
# DATABASE_URL=postgresql://user:password@localhost/genivra

# ============================================================================
# Monitoring & Logging (Optional)
# ============================================================================

# Enable usage metrics tracking
ENABLE_METRICS=true

# Log predictions to file (optional, for audit trail)
LOG_PREDICTIONS=false
PREDICTIONS_LOG_FILE=logs/predictions.log

# ============================================================================
# Security Settings
# ============================================================================

# HTTPS enforcement (set to true in production)
REQUIRE_HTTPS=false

# API documentation access
ENABLE_API_DOCS=true
ENABLE_REDOC=true
ENABLE_OPENAPI=true

# ============================================================================
# Deployment Platform
# ============================================================================

# Platform identifier (heroku, railway, render, vercel, gcp, aws, azure)
DEPLOYMENT_PLATFORM=local

# Application name (for logging/monitoring)
APP_NAME=Genivra CNS Risk Engine API

# Application version
APP_VERSION=1.0.0
